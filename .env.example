# Copiar a .env.local (ignorado por git) y completar.
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cadena de modelos con capa gratuita, separados por coma. Si uno agota su cuota diaria, se usa el siguiente.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Los límites de la capa gratuita (RPM / RPD) no están en la documentación pública:
# se ven por proyecto en https://aistudio.google.com/rate-limit
# Una corrida usa como máximo 25 llamadas (16 del agente + 9 de proveedores).
# Medido November 10, 2026: gemini-3.6-flash corta a los 5 pedidos por minuto en la capa gratuita;
# gemini-3.5-flash-lite: 500 pedidos por día por proyecto (medido el mismo día al agotarse).
