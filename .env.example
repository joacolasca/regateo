# Copiar a .env.local (ignorado por git) y completar.
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo Flash estable con capa gratuita (docs de modelos y precios, revisado November 10, 2026).
GEMINI_MODEL=gemini-3.6-flash
# Los límites de la capa gratuita (RPM / RPD) no están en la documentación pública:
# se ven por proyecto en https://aistudio.google.com/rate-limit
# Una corrida usa como máximo 25 llamadas (16 del agente + 9 de proveedores).
